<Page x:Class="PracticeWork2.Pages.PageTask5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PracticeWork2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTask5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#FAFAFA" Margin="25">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Задание 5: Сортировка двумерного массива" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Условие: Сгенерировать массив размером M столбцов и N строк, содержащий числа от -10 до 10. Отсортировать элементы по возрастанию и по убыванию. Вывести результаты в двух таблицах. Найти min и max." 
                           TextWrapping="Wrap" FontSize="14" Foreground="#444" Margin="0,0,0,15"/>

                <!-- Настройки размеров матрицы -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Строк (N):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="tbRows" Width="50" Height="26" Text="3" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="Столбцов (M):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="tbCols" Width="50" Height="26" Text="4" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                    <Button Content="Сгенерировать и отсортировать" Height="30" Padding="12,0" Click="btnGenerateAndSort_Click"/>
                </StackPanel>

                <!-- Исходная матрица -->
                <TextBlock Text="Исходная матрица:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DataGrid x:Name="dgInitial" AutoGenerateColumns="True" HeadersVisibility="None" 
                          Height="110" IsReadOnly="True" Margin="0,0,0,15"/>

                <!-- Отсортированная по возрастанию -->
                <TextBlock Text="Сортировка по возрастанию:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DataGrid x:Name="dgAscending" AutoGenerateColumns="True" HeadersVisibility="None" 
                          Height="110" IsReadOnly="True" Margin="0,0,0,15"/>

                <!-- Отсортированная по убыванию -->
                <TextBlock Text="Сортировка по убыванию:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DataGrid x:Name="dgDescending" AutoGenerateColumns="True" HeadersVisibility="None" 
                          Height="110" IsReadOnly="True" Margin="0,0,0,15"/>

                <!-- Минимум и максимум -->
                <Grid Margin="0,5,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Минимальный элемент:" Margin="0,0,0,5"/>
                        <TextBox x:Name="tbMin" Height="30" IsReadOnly="True" Background="#EFEFEF"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Максимальный элемент:" Margin="0,0,0,5"/>
                        <TextBox x:Name="tbMax" Height="30" IsReadOnly="True" Background="#EFEFEF"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
