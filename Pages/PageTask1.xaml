<Page x:Class="PracticeWork2.Pages.PageTask1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PracticeWork2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTask1">

    <Grid Background="#FAFAFA" Margin="25">
        <StackPanel MaxWidth="700" Margin="0,0,0,0">
            <TextBlock Text="Задание 1: Определение номера столетия" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Условие: Дан номер некоторого года (положительное целое число). Вывести соответствующий ему номер столетия, учитывая, что, к примеру, началом 20 столетия был 1901 год." 
                       TextWrapping="Wrap" FontSize="14" Foreground="#444" Margin="0,0,0,20"/>

            <TextBlock Text="Введите положительный номер года:" FontSize="14" Margin="0,0,0, 5"/>
            <TextBox x:Name="tbYearInput" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <Button x:Name="btnCalculate" Content="Вычислить столетие" Width="200" Height="36" 
                    HorizontalAlignment="Left" FontSize="14" Click="btnCalculate_Click" Margin="0,0,0,20"/>

            <TextBlock Text="Результат:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbResult" Height="30" FontSize="14" VerticalContentAlignment="Center" 
                     IsReadOnly="True" Background="#EFEFEF"/>
        </StackPanel>
        
    </Grid>
</Page>
