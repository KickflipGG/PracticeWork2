<Page x:Class="PracticeWork2.Pages.PageMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PracticeWork2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главное меню">

    <Grid Background="#F4F6F8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <Border Background="#E2F0D9" CornerRadius="8" Padding="15" Margin="0,0,0,25" BorderBrush="#70AD47" BorderThickness="1">
                <TextBlock Text="Вариант №6" FontSize="26" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="#385723"/>
            </Border>

            <Button Content="Задача 1: Определение столетия" Height="42" Margin="0,5" FontSize="14" Click="btnTask1_Click"/>
            <Button Content="Задача 2: Проверка круглых скобок" Height="42" Margin="0,5" FontSize="14" Click="btnTask2_Click"/>
            <Button Content="Задача 3: Три числа с макс. произведением" Height="42" Margin="0,5" FontSize="14" Click="btnTask3_Click"/>
            <Button Content="Задача 4: Промежутки монотонности" Height="42" Margin="0,5" FontSize="14" Click="btnTask4_Click"/>
            <Button Content="Задача 5: Сортировка двумерного массива" Height="42" Margin="0,5" FontSize="14" Click="btnTask5_Click"/>
        </StackPanel>
    </Grid>
</Page>
