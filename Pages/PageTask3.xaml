<Page x:Class="PracticeWork2.Pages.PageTask3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PracticeWork2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTask3">

    <Grid Background="#FAFAFA" Margin="25">
        <StackPanel MaxWidth="700" HorizontalAlignment="Center" Width="780">
            <TextBlock Text="Задание 3: Поиск трех чисел с максимальным произведением" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Условие: Дано N целых чисел. Требуется выбрать из них три таких числа, произведение которых максимально." 
                       TextWrapping="Wrap" FontSize="14" Foreground="#444" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Сгенерировать случайные числа" Height="32" Padding="10,0" Click="btnGenerate_Click" Margin="0,0,10,0"/>
                <TextBlock Text="(или введите вручную через пробел)" VerticalAlignment="Center" Foreground="#666"/>
            </StackPanel>

            <TextBox x:Name="tbArrayInput" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <Button x:Name="btnFind" Content="Найти тройку чисел" Width="200" Height="36" 
                    HorizontalAlignment="Left" FontSize="14" Click="btnFind_Click" Margin="0,0,0,20"/>

            <TextBlock Text="Результат:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbResult" Height="60" TextWrapping="Wrap" FontSize="14" 
                     IsReadOnly="True" Background="#EFEFEF"/>
        </StackPanel>
    </Grid>
</Page>
