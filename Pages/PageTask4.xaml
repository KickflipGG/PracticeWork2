<Page x:Class="PracticeWork2.Pages.PageTask4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PracticeWork2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTask4">

    <Grid Background="#FAFAFA" Margin="25">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Задание 4: Перестановка промежутков монотонности" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Условие: Определить количество промежутков монотонности (участков возрастания или убывания) и поменять местами первый и последний из них." 
                       TextWrapping="Wrap" FontSize="14" Foreground="#444" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Сгенерировать массив" Height="32" Padding="10,0" Click="btnGenerate_Click" Margin="0,0,10,0"/>
                <TextBlock Text="(или введите целые числа через пробел)" VerticalAlignment="Center" Foreground="#666"/>
            </StackPanel>

            <TextBox x:Name="tbArrayInput" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <Button x:Name="btnProcess" Content="Выполнить перестановку" Width="220" Height="36" 
                    HorizontalAlignment="Left" FontSize="14" Click="btnProcess_Click" Margin="0,0,0,20"/>

            <TextBlock Text="Количество промежутков монотонности:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbCount" Height="30" FontSize="14" VerticalContentAlignment="Center" 
                     IsReadOnly="True" Background="#EFEFEF" Margin="0,0,0,15"/>

            <TextBlock Text="Массив после перестановки:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbResult" Height="30" FontSize="14" VerticalContentAlignment="Center" 
                     IsReadOnly="True" Background="#EFEFEF"/>
        </StackPanel>
    </Grid>
</Page>
