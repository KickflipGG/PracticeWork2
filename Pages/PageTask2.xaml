<Page x:Class="PracticeWork2.Pages.PageTask2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PracticeWork2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTask2">

    <Grid Background="#FAFAFA" Margin="25">
        <StackPanel MaxWidth="700" HorizontalAlignment="Center" Width="750">
            <TextBlock Text="Задание 2: Проверка круглых скобок" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Условие: Дана строка со скобками. Если скобки расставлены правильно, вывести 0. Если есть ошибочная закрывающая — вывести ее номер позиции (с 1). Если закрывающих не хватает — вывести -1." 
                       TextWrapping="Wrap" FontSize="14" Foreground="#444" Margin="0,0,0,20"/>

            <TextBlock Text="Введите строку для проверки:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbStringInput" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <Button x:Name="btnCheck" Content="Проверить скобки" Width="200" Height="36" 
                    HorizontalAlignment="Left" FontSize="14" Click="btnCheck_Click" Margin="0,0,0,20"/>

            <TextBlock Text="Результат анализа:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbResult" Height="30" FontSize="14" VerticalContentAlignment="Center" 
                     IsReadOnly="True" Background="#EFEFEF"/>
        </StackPanel>
    </Grid>
</Page>
